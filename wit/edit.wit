package t-rustable:api@0.1.1;

/// Changes to a document, as atomic transactions of core commands. Permission: document.edit.
/// New core commands come as new `transaction` methods.
interface edit {
    use types.{page-id, object-id, transaction-id, point, rect, color, stroke, text-style, api-error};
    use document.{doc};

    /// Geometry of a shape for `add-shape`.
    variant shape {
        rect(rect),
        ellipse(rect),
        line(tuple<point, point>),
        polyline(list<point>),
    }

    /// A transaction that is not committed yet. Each method checks its command at once.
    /// Drop it without `commit` to discard it. It is valid only during the export call that
    /// opened it: after that call, the host discards it, and each method returns `expired`.
    resource transaction {
        delete-page: func(page: page-id) -> result<_, api-error>;
        /// Moves the page before `before`. None moves it to the end.
        move-page: func(page: page-id, before: option<page-id>) -> result<_, api-error>;
        /// Adds `degrees` to the current rotation. A multiple of 90. Positive is clockwise.
        rotate-page: func(page: page-id, degrees: s32) -> result<_, api-error>;
        /// Inserts a blank page before `before`. None inserts it at the end.
        insert-blank-page: func(before: option<page-id>, width: f64, height: f64) -> result<page-id, api-error>;
        /// One line of text. `at` is the start of the baseline. The text reads upright for the
        /// reader: on a rotated page, the baseline turns with the page rotation.
        add-text: func(page: page-id, at: point, text: string, style: text-style) -> result<object-id, api-error>;
        /// `data` is a PNG or JPEG file. The image fills `bounds` and reads upright for the
        /// reader: on a page rotated by 90 or 270 degrees, the image width runs along the
        /// height of `bounds`.
        add-image: func(page: page-id, bounds: rect, data: list<u8>) -> result<object-id, api-error>;
        add-shape: func(page: page-id, shape: shape, stroke: option<stroke>, fill: option<color>) -> result<object-id, api-error>;
        remove-object: func(object: object-id) -> result<_, api-error>;

        /// Applies all commands at once. On error, nothing changes.
        commit: static func(tx: transaction) -> result<transaction-id, api-error>;
    }

    begin: func(document: borrow<doc>, label: string) -> result<transaction, api-error>;
}
